# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
APP_IMAGE=registry.xzzandzyc.store:5000/project/warehouse-carbon:latest

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-secret
LITESTAR_DEBUG=false
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=8000
APP_URL=https://warehouse-carbon.example.com
APP_ENV=production
LOG_LEVEL=20

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_ECHO=false
DATABASE_ECHO_POOL=false
DATABASE_POOL_DISABLED=false
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30
DATABASE_USER=app
DATABASE_PASSWORD=replace-with-a-strong-db-password
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=warehouse_carbon
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}

# -----------------------------------------------------------------------------
# SAQ / Redis
# -----------------------------------------------------------------------------
SAQ_USE_SERVER_LIFESPAN=false
SAQ_WEB_ENABLED=true
SAQ_PROCESSES=1
SAQ_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
VITE_DEV_MODE=false
VITE_PORT=18101
ALLOWED_CORS_ORIGINS=["https://warehouse-carbon.example.com"]
COOKIE_SECURE=true

# ALTCHA Sentinel
ALTCHA_SENTINEL_URL=https://sentinel.example.com
ALTCHA_SENTINEL_INTERNAL_URL=http://sentinel:8080
ALTCHA_SENTINEL_API_KEY=replace-with-sentinel-api-key
ALTCHA_SENTINEL_VERIFY_PATH=/v1/verify/signature
LOGIN_RISK_THRESHOLD=5
LOGIN_RISK_WINDOW_SECONDS=900
LOGIN_RISK_BLOCK_SECONDS=3600
