# App Configuration
SECRET_KEY=change-me
APP_ENV=development
LITESTAR_DEBUG=true
LITESTAR_HOST=0.0.0.0
LITESTAR_PORT=18100
APP_URL=http://localhost:18100
APP_DISPLAY_NAME=碳数据收集与管理系统
APP_SHORT_NAME=CD
APP_DESCRIPTION=支持 Scope 1/2/3 碳排放数据的采集、审核与统计分析。
LOG_LEVEL=20
VITE_PORT=18101
ALLOWED_CORS_ORIGINS=["http://127.0.0.1:18101","http://localhost:18101","http://127.0.0.1:18100","http://localhost:18100"]
COOKIE_SECURE=false

# Database Configuration
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_HOST=localhost
DATABASE_PORT=18102
DATABASE_DB=app
DATABASE_URL=postgresql+psycopg://app:app@localhost:18102/app

# SAQ / Redis Configuration
SAQ_REDIS_URL=redis://localhost:18103/0
SAQ_WEB_ENABLED=true
# MQTT ingress runs as a separate SAQ worker role with this queue concurrency.
MQTT_INGEST_CONCURRENCY=1
# Reference these variable names from an iot_mqtt_data_source record. Do not put credentials in the database.
SZSCADA_MQTT_USERNAME=
SZSCADA_MQTT_PASSWORD=
LOGIN_RISK_THRESHOLD=5
LOGIN_RISK_WINDOW_SECONDS=900
LOGIN_RISK_BLOCK_SECONDS=3600

# ALTCHA Sentinel
ALTCHA_SENTINEL_URL=http://localhost:18108
ALTCHA_SENTINEL_INTERNAL_URL=http://localhost:18108
ALTCHA_SENTINEL_API_KEY=3bbff89f5aead0809a583eeae2cbb2f7e44ed05f298947d75813905841fae7b1
ALTCHA_SENTINEL_VERIFY_PATH=/v1/verify/signature

# Local service ports
